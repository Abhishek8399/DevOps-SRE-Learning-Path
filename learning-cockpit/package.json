{
  "name": "devops-sre-learning-cockpit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "npm run prepare:local-runtime",
    "prepare:local-runtime": "node ../tools/patch-vinext-windows-static-cache.mjs",
    "predev": "npm run validate:content",
    "dev": "vinext dev",
    "start:dev": "vinext dev",
    "prebuild": "npm run validate:content",
    "build": "vinext build",
    "start": "npm run prepare:local-runtime && vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --pretty false",
    "generate:content-registry": "node ../tools/generate-content-registry.mjs",
    "check:content-registry": "node ../tools/generate-content-registry.mjs --check",
    "validate:content": "node ../tools/validate-content.mjs && npm run check:content-registry",
    "test:content-schema": "node --test --test-isolation=none ../tools/tests/content-schema.test.mjs",
    "test:reader": "node --experimental-strip-types --test --test-isolation=none tests/reader.test.mjs",
    "test:evidence-export": "node --experimental-strip-types --test tests/evidence-export.test.mjs",
    "audit:web-budget": "node ../tools/audit-web-budget.mjs",
    "audit:runtime": "npm audit --omit=dev --audit-level=moderate"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "nanoid": "3.3.18"
  },
  "type": "module"
}
