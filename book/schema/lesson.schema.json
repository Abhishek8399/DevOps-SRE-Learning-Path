{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devops-sre-learning.local/schema/lesson-v1.json",
  "title": "Systems Reliability Field Manual lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "slug",
    "aliases",
    "curriculumIds",
    "route",
    "order",
    "volume",
    "title",
    "summary",
    "domain",
    "level",
    "estimatedMinutes",
    "prerequisiteLessonIds",
    "prerequisiteCurriculumIds",
    "testedEnvironments",
    "targetRoles",
    "learningObjectives",
    "productionSignals",
    "diagrams",
    "commands",
    "labs",
    "incidents",
    "assessmentIds",
    "referenceIds",
    "contentStatus",
    "masteryBoundary",
    "lastReviewed",
    "reviewAfter",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "lesson" },
    "id": { "$ref": "#/$defs/lessonId" },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 100,
        "pattern": "^(?:V[0-9]{2}-L[0-9]{2,3}|[a-z0-9]+(?:-[a-z0-9]+)*)$"
      }
    },
    "curriculumIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/curriculumId" }
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 100
    },
    "volume": {
      "type": "string",
      "pattern": "^[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "route": {
      "type": "string",
      "pattern": "^/book/[a-z0-9]+(?:/[a-z0-9-]+)+$"
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9999
    },
    "summary": { "$ref": "#/$defs/nonEmptyString" },
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "enum": ["foundation", "intermediate", "advanced", "expert"] },
        "to": { "enum": ["foundation", "intermediate", "advanced", "expert"] }
      }
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 10,
      "maximum": 600
    },
    "prerequisiteLessonIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/lessonId" }
    },
    "prerequisiteCurriculumIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/curriculumId" }
    },
    "testedEnvironments": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/testedEnvironment" }
    },
    "targetRoles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "learningObjectives": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "productionSignals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "diagrams": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/diagram" }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/command" }
    },
    "labs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lab" }
    },
    "incidents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/incident" }
    },
    "assessmentIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/assessmentId" }
    },
    "referenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/referenceId" }
    },
    "contentStatus": {
      "enum": ["seeded", "substantive-draft", "review-required"]
    },
    "masteryBoundary": {
      "const": "publication-does-not-award-mastery"
    },
    "lastReviewed": { "$ref": "#/$defs/date" },
    "reviewAfter": { "$ref": "#/$defs/date" },
    "limitations": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "curriculumId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{1,15}-[0-9]{3}$"
    },
    "lessonId": {
      "type": "string",
      "pattern": "^LES-[0-9]{4}$"
    },
    "assessmentId": {
      "type": "string",
      "pattern": "^ASM-[0-9]{4}$"
    },
    "referenceId": {
      "type": "string",
      "pattern": "^REF-[0-9]{4}$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^LES-[0-9]{4}-(DIA|CMD|LAB|INC|Q|INT|XFER)-[0-9]{3}$"
    },
    "testedEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "version", "support"],
      "properties": {
        "platform": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "support": {
          "enum": ["required", "supported", "concept-only", "unsupported"]
        },
        "notes": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "direction",
        "boundaries",
        "evidencePoints",
        "textAlternative"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "direction": {
          "enum": ["left-to-right", "top-to-bottom", "cyclic", "hierarchical"]
        },
        "boundaries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "evidencePoints": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "textAlternative": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "signal", "firstThought", "safePath", "trap"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "signal": { "$ref": "#/$defs/nonEmptyString" },
        "firstThought": { "$ref": "#/$defs/nonEmptyString" },
        "safePath": { "$ref": "#/$defs/nonEmptyString" },
        "trap": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "risk",
        "command",
        "runFrom",
        "expectedBranches",
        "proves",
        "doesNotProve"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "question": { "$ref": "#/$defs/nonEmptyString" },
        "risk": {
          "enum": [
            "read-only",
            "sampled-read-only",
            "mutating-bounded",
            "destructive-disposable",
            "networked-install"
          ]
        },
        "command": { "$ref": "#/$defs/nonEmptyString" },
        "runFrom": { "$ref": "#/$defs/nonEmptyString" },
        "expectedBranches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when", "meaning", "nextEvidence"],
            "properties": {
              "when": { "$ref": "#/$defs/nonEmptyString" },
              "meaning": { "$ref": "#/$defs/nonEmptyString" },
              "nextEvidence": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "proves": { "$ref": "#/$defs/nonEmptyString" },
        "doesNotProve": { "$ref": "#/$defs/nonEmptyString" },
        "cleanup": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "lab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "mode",
        "environment",
        "timeMinutes",
        "privilege",
        "network",
        "changes",
        "abortConditions",
        "recovery",
        "cleanupProof"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "mode": { "enum": ["guided", "independent"] },
        "environment": { "$ref": "#/$defs/nonEmptyString" },
        "timeMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "privilege": { "$ref": "#/$defs/nonEmptyString" },
        "network": { "$ref": "#/$defs/nonEmptyString" },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "abortConditions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "recovery": { "$ref": "#/$defs/nonEmptyString" },
        "cleanupProof": { "$ref": "#/$defs/nonEmptyString" },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$)).+$"
        }
      }
    }
  }
}
